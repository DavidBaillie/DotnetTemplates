{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "Enabled": "true/false",
    "PermitLimit": "(integer) -> How many transactions per window?",
    "WindowSeconds": "(integer) -> How many seconds per window?",
    "QueueLimit": 0
  },
  "Database": {
    "Provider": "sqlite / postgresql",
    "ConnectionString": ""
  },
  "ApiKey": "your-api-key-here",
  "Authentication": {
    "WellKnownEndpoint": "https://your-identity-provider/.well-known/openid-configuration",
    "Issuer": "https://your-identity-provider"
  }
}
